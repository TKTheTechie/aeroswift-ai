# ── Shared config loaded from common-properties/.env ─────────────────────────
# SOLACE_HOST, SOLACE_WS_PORT, SOLACE_VPN, SOLACE_USERNAME, SOLACE_PASSWORD
# TOPIC_VIDEO_FEED, TOPIC_ANALYTICS
# ─────────────────────────────────────────────────────────────────────────────

# Solace PubSub+ Configuration (VITE_ prefix required for client-side exposure)
# Values mapped from common-properties/.env via dotenv-expand
VITE_SOLACE_URL=ws://${SOLACE_HOST}:${SOLACE_WS_PORT}
VITE_SOLACE_VPN=${SOLACE_VPN}
VITE_SOLACE_USERNAME=${SOLACE_USERNAME}
VITE_SOLACE_PASSWORD=${SOLACE_PASSWORD}

# Application Topics (mapped from common-properties/.env)
VITE_VIDEO_TOPIC=${TOPIC_VIDEO_FEED}
VITE_ANALYTICS_TOPIC=${TOPIC_ANALYTICS}
VITE_FACE_MATCH_RESULT_TOPIC=${TOPIC_FACE_MATCH_RESULT}
VITE_FACE_SCAN_RESET_TOPIC=${TOPIC_FACE_SCAN_RESET}
VITE_FACE_MATCH_ERROR_TOPIC=${TOPIC_FACE_MATCH_ERROR}
VITE_PASSENGER_LOOKUP_RESPONSE_TOPIC=${TOPIC_PASSENGER_LOOKUP_RESPONSE}
VITE_BOARDING_BOARDED_TOPIC=aeroswift/terminal1/v1/boarding/boarded
VITE_BOARDING_NOT_BOARDED_TOPIC=aeroswift/terminal1/v1/boarding/not-boarded

# Demo Mode (set to 'true' to run without Solace connection)
VITE_DEMO_MODE=false

# Webcam Mode (set to 'true' to use browser webcam instead of ESP32 camera)
# Captures frames on face detection and publishes them to Solace topics
VITE_WEBCAM_MODE=false

# Webcam Session ID (set to 'true' to append a UUID session ID to the webcam topic and generate a QR code)
# When false, no session ID is appended and no QR code is shown
VITE_WEBCAM_SESSION_ID_ENABLED=false

# URL for the Qdrant face recognition service (opened in a new tab from the splash screen)
VITE_QDRANT_SERVICE_URL=http://ec2-18-206-222-103.compute-1.amazonaws.com:3001
